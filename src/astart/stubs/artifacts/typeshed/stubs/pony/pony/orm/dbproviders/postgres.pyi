import types
from collections.abc import Iterable
from typing import ClassVar

from _typeshed import Incomplete
from pony.orm import dbapiprovider, dbschema
from pony.orm.dbapiprovider import DBAPIProvider, Pool
from pony.orm.sqlbuilding import SQLBuilder, Value
from pony.orm.sqltranslation import SQLTranslator
from psycopg2._psycopg import _Connection

NoneType: type[None]

class PGColumn(dbschema.Column):
    auto_template: ClassVar[str]

class PGSchema(dbschema.DBSchema):
    dialect: ClassVar[str]
    column_class: ClassVar[type[PGColumn]]

class PGTranslator(SQLTranslator):
    dialect: ClassVar[str]

class PGValue(Value):
    __slots__: list[str] = []

class PGSQLBuilder(SQLBuilder):
    dialect: ClassVar[str]
    value_class: ClassVar[type[PGValue]]
    def INSERT(self, table_name, columns, values, returning=None): ...
    def TO_INT(self, expr): ...
    def TO_STR(self, expr): ...
    def TO_REAL(self, expr): ...
    def DATE(self, expr): ...
    def RANDOM(self): ...
    def DATE_ADD(self, expr, delta): ...
    def DATE_SUB(self, expr, delta): ...
    def DATE_DIFF(self, expr1, expr2): ...
    def DATETIME_ADD(self, expr, delta): ...
    def DATETIME_SUB(self, expr, delta): ...
    def DATETIME_DIFF(self, expr1, expr2): ...
    def eval_json_path(self, values: Iterable[int | str]) -> str: ...  # type: ignore[override]
    def JSON_QUERY(self, expr, path): ...
    json_value_type_mapping: dict[type, str]
    def JSON_VALUE(self, expr, path, type): ...
    def JSON_NONZERO(self, expr): ...
    def JSON_CONCAT(self, left, right): ...
    def JSON_CONTAINS(self, expr, path, key): ...
    def JSON_ARRAY_LENGTH(self, value): ...
    def GROUP_CONCAT(self, distinct, expr, sep=None): ...
    def ARRAY_INDEX(self, col, index): ...
    def ARRAY_CONTAINS(self, key, not_in, col): ...
    def ARRAY_SUBSET(self, array1, not_in, array2): ...
    def ARRAY_LENGTH(self, array): ...
    def ARRAY_SLICE(self, array, start, stop): ...
    def MAKE_ARRAY(self, *items): ...

class PGIntConverter(dbapiprovider.IntConverter):
    signed_types: Incomplete
    unsigned_types: Incomplete

class PGRealConverter(dbapiprovider.RealConverter):
    def sql_type(self): ...

class PGBlobConverter(dbapiprovider.BlobConverter):
    def sql_type(self): ...

class PGTimedeltaConverter(dbapiprovider.TimedeltaConverter): ...
class PGDatetimeConverter(dbapiprovider.DatetimeConverter): ...

class PGUuidConverter(dbapiprovider.UuidConverter):
    def py2sql(self, val): ...

class PGJsonConverter(dbapiprovider.JsonConverter):
    def sql_type(self): ...

class PGArrayConverter(dbapiprovider.ArrayConverter):
    array_types: dict[type, tuple[str, type]]

class PGPool(Pool):
    def release(self, con) -> None: ...

ADMIN_SHUTDOWN: str

class PGProvider(DBAPIProvider):
    dialect: ClassVar[str]
    dbapi_module: ClassVar[types.ModuleType]
    dbschema_cls: ClassVar[type[PGSchema]]
    translator_cls: ClassVar[type[PGTranslator]]
    sqlbuilder_cls: ClassVar[type[PGSQLBuilder]]
    array_converter_cls: ClassVar[type[PGArrayConverter]]
    default_schema_name: ClassVar[str]
    fk_types: ClassVar[dict[str, str]]
    converter_classes: list[tuple[type | tuple[type], type]]
    def normalize_name(self, name: str) -> str: ...
    def inspect_connection(self, connection: _Connection) -> None: ...
    def should_reconnect(self, exc: BaseException | None) -> bool: ...
    def get_pool(self, *args, **kwargs) -> PGPool: ...
    def set_transaction_mode(self, connection: _Connection, cache) -> None: ...
    def execute(
        self,
        cursor,
        sql,
        arguments=None,
        returning_id: bool = False,
    ): ...
    def table_exists(
        self,
        connection: _Connection,
        table_name: str,
        case_sensitive: bool = True,
    ): ...
    def index_exists(
        self,
        connection: _Connection,
        table_name: str,
        index_name,
        case_sensitive: bool = True,
    ): ...
    def fk_exists(
        self,
        connection: _Connection,
        table_name: str,
        fk_name,
        case_sensitive: bool = True,
    ): ...
    def drop_table(self, connection: _Connection, table_name: str) -> None: ...

provider_cls = PGProvider
