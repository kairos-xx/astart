from typing import TypeVar, type_check_only

from google.protobuf.descriptor import EnumDescriptor

_V = TypeVar("_V", bound=int)

@type_check_only
class _EnumTypeWrapper[V: int](type):
    DESCRIPTOR: EnumDescriptor
    def __init__(cls, enum_type: EnumDescriptor) -> None: ...
    def Name(cls, number: _V) -> str: ...
    def Value(cls, name: str | bytes) -> _V: ...
    def keys(cls) -> list[str]: ...
    def values(cls) -> list[_V]: ...
    def items(cls) -> list[tuple[str, _V]]: ...

class EnumTypeWrapper(_EnumTypeWrapper[int]):
    ValueType = int
