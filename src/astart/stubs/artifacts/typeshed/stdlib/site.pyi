if sys.version_info >= (3, 15):
    class StartupState:
        __slots__ = (
            "_entrypoints",
            "_importexecs",
            "_known_paths",
            "_path_entries",
            "_processed_sitedirs",
        )
        def __init__(self, known_paths: set[str] | None = None) -> None: ...
        def addsitedir(self, sitedir: str) -> None: ...
        def addusersitepackages(self) -> None: ...
        def addsitepackages(
            self,
            prefixes: Iterable[str] | None = None,
        ) -> None: ...
        def process(self) -> None: ...

